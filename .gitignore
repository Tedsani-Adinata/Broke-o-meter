# ==============================================================================
# Broke-o-meter .gitignore
# ==============================================================================

# Node dependencies
node_modules/
.pnp
.pnp.js

# Production / Web build output (generated by `npm run build` or `npm run sync`)
www/*
!www/.gitkeep
dist/

# Logs
logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Android / Gradle artifacts & local configs
.gradle/
build/
android/.gradle/
android/.kotlin/
android/build/
android/app/build/
android/local.properties
android/captures/
android/.navigation/
android/capacitor-cordova-android-plugins/
android/app/src/main/assets/public/
android/app/src/main/assets/capacitor.config.json
android/app/src/main/assets/capacitor.plugins.json

# Android Studio & IDE configurations
.idea/
*.iml
android/*.iml
android/app/*.iml
.vscode/
*.sw?
*.suo
*.ntvs*
*.njsproj

# OS generated files & temporary buffers
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
*.bak
*.tmp
*~

# Keystores & Signing secrets
*.jks
*.keystore
*.p8
*.p12
*.key
*.mobileprovision
